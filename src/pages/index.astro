---
import DefaultLayout from '../layouts/DefaultLayout.astro';

import Head from '../components/Head.astro';
import ImageShadow from "../components/ImageShadow.astro";
import Nav from "../components/Nav.astro";
import Section from "../components/Section.astro";

import profileImage from "../assets/image/AstraGuitar.webp";
import profileImageShadow from "../assets/image/AstraGuitar_Shadow.webp";
import zephySilly from "../assets/image/ZephyrSilly.png";
import siteLogo from "../assets/image/DreamingCassete_logo.png";
import astraPfp from "../assets/image/AstraPFP.png";
---

<DefaultLayout>
	<Head slot="head" title="DreamingCassette - Home"
		description="My official portfolio site. Get in contact or browse my artwork"
		image={astraPfp.src} url="https://dreamingcassette.com" />

	<main slot="main">
		<img id="site-logo" src={siteLogo.src} alt="Site Logo" fetchpriority="high">

		<Section uid="about">
			<div>
				<Nav currentPage="home"/>
				<p>EMAIL: dreamingcassette@gmail.com</p>
				<div class="info-box">
					<h1 class="grid-span">About Dreamingcassette</h1>
					<ul class="grid-span">
						<li>2D Illustrator/Animator</li>
						<li>Writer</li>
						<li>Started PSYCHO ENGINE with ZephyrBytes. We try to make games</li>
					</ul>
					<h1 class="grid-span">Programs I Use</h1>
					<ul class="grid-span">
						<li>Krita (Main Pick)</li>
						<li>Clip Studio Paint</li>
						<li>ibisPaint</li>
						<li>Obsidian</li>
					</ul>
					<div class="align-row">
						<img src={zephySilly.src} alt="">
						<p>go checkout <a href="https://kawaiibakemono.art/home/" target="_blank">
							zephyrbytes</a> she's super cool (she made this website for me)</p>
					</div>

				</div>
			</div>
			<ImageShadow image={profileImage.src} shadow={profileImageShadow.src} alt="Astra Gutiar" />
		</Section>
		<Section uid="second-section"></Section>
		<footer>
			Made by ZephyrBytes
		</footer>
	</main>
</DefaultLayout>

<style lang="sass">
	@use "../styles/_variables" as *

	main
		display: flex
		flex-direction: column
		margin:
			left: 10vw
			right: 10vw
		z-index: 1
		background-image: url("../assets/image/background.jpg")
		background-size: 80vw
		background-origin: border-box
		background-repeat: no-repeat

	a
		color: $color-accent-default

	img
		display: flex

		&#site-logo
			margin:
				top: $gap-default
				right: $gap-default
			height: 7rem
			margin-left: auto

	.info-box
		display: flex
		flex-direction: column
		align-items: flex-start
		justify-content: space-between
		padding: $gap-default $gap-large
		background-color: $color-background-default
		margin:
			top: $gap-large
			bottom: $gap-huge
		border: 6px solid $color-background-dark
		width: 32vw

		img
			width: 6vw

	.align-row
		display: flex
		flex-direction: row
		gap: $gap-default

	h1
		font-size: $font-size-h1
		margin-block-start: $gap-tiny
		margin-block-end: $gap-tiny
		text-transform: uppercase

	ul
		padding-inline-start: $gap-large
		padding-inline-end: $gap-large

	li
		list-style-image: url("/src/assets/svg/Rocket.svg")
</style>
