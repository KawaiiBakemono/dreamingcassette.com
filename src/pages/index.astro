---
import DefaultLayout from '../layouts/DefaultLayout.astro';

// COMPONENTS
import Head from '../components/Head.astro';
import ImageShadow from "../components/ImageShadow.astro";
import Nav from "../components/Nav.astro";
import Section from "../components/Section.astro";
import Footer from "../components/Footer.astro"

// IMAGES
import profileImage from "../assets/image/AstraGuitar.webp";
import profileImageShadow from "../assets/image/AstraGuitar_Shadow.webp";
import zephySilly from "../assets/image/ZephyrSilly.webp";
import siteLogo from "../assets/image/DreamingCassete_logo.webp";
import astraPfp from "../assets/image/AstraPfp.webp";
import stickerAstra from "../assets/image/StickerAstra.webp";
import stickerDrone from "../assets/image/StickerDrone.webp";
import stickerRaptor from "../assets/image/StickerRaptor.webp";
---

<DefaultLayout overflow="scroll">
	<Head slot="head" title="DreamingCassette - Home"
		description="My official portfolio site. Get in contact or browse my artwork"
		image={astraPfp.src} url="https://dreamingcassette.com" />

	<main slot="main">
		<img id="site-logo" src={siteLogo.src} alt="Site Logo" fetchpriority="high">

		<Section uid="about">
			<div>
				<Nav currentPage="home"/>
				<p>EMAIL: dreamingcassette@gmail.com</p>
				<div class="info-box">
					<h1 class="grid-span">About Dreamingcassette</h1>
					<ul class="grid-span">
						<li>2D Illustrator/Animator</li>
						<li>Writer</li>
						<li>Started PSYCHO ENGINE with ZephyrBytes. We try to make games</li>
					</ul>
					<h1 class="grid-span">Programs I Use</h1>
					<ul class="grid-span">
						<li>Krita <span class="muted">(Main Pick)</span></li>
						<li>Clip Studio Paint</li>
						<li>ibisPaint</li>
						<li>Obsidian</li>
					</ul>
					<div class="align-row">
						<img src={zephySilly.src} alt="">
						<p>Go checkout <a href="https://kawaiibakemono.art/home/" target="_blank">
							ZephyrBytes</a>, she's super cool (she made this website for me)</p>
					</div>
				</div>
			</div>
			<ImageShadow image={profileImage.src} shadow={profileImageShadow.src} alt="Astra Gutiar" />
		</Section>
		<Section uid="second-section">
			<div class="scrolling-banner">
				<img src={stickerDrone.src} alt="">
				<img src={stickerRaptor.src} alt="">
				<img src={stickerAstra.src} alt="">
			</div>
		</Section>
		<Footer />
	</main>
</DefaultLayout>

<style lang="sass">
	@use "../styles/_variables" as *

	main
		display: flex
		flex-direction: column
		margin:
			left: 10vw
			right: 10vw
		z-index: 1
		background-image: url("../assets/image/background.jpg")
		background-size: 80vw
		background-origin: border-box
		background-repeat: no-repeat
		overflow-x: hidden

	a
		color: $color-accent-default

	img
		display: flex

		&#site-logo
			margin:
				top: $gap-default
				right: $gap-default
			height: 7rem
			margin-left: auto

	.info-box
		display: flex
		flex-direction: column
		align-items: flex-start
		justify-content: space-between
		padding: $gap-default $gap-large
		background-color: $color-background-default
		margin:
			top: $gap-large
			bottom: $gap-huge
		border: 20px solid $color-foreground-default
		width: 32vw

		img
			align-self: center
			width: 6rem
			filter: drop-shadow(0.5rem 0 $color-shadow)

	.align-row
		display: flex
		flex-direction: row
		gap: $gap-default

	h1
		font-size: $font-size-h1
		margin-block-start: $gap-tiny
		margin-block-end: $gap-tiny
		text-transform: uppercase

	ul
		padding-inline-start: $gap-large
		padding-inline-end: $gap-large

	li
		list-style-image: url("/src/assets/svg/Rocket.svg")

	.muted
		color: $color-foreground-muted

	.scrolling-banner
		display: flex
		flex-direction: row
		overflow: visible
		animation: banner-scroll 20s linear infinite

		img
			overflow: scroll
			padding-bottom: $gap-large

		img:nth-of-type(1)
			background: radial-gradient(ellipse 30% 5% at 50% 90%, $color-shadow 99%, transparent)

		img:nth-of-type(2)
			background: radial-gradient(ellipse 50% 5% at 50% 90%, $color-shadow 99%, transparent)

		img:nth-of-type(3)
			background: radial-gradient(ellipse 30% 5% at 50% 90%, $color-shadow 99%, transparent)

	@keyframes banner-scroll
		0%
			transform: translate(-100%, 0)
		100%
			transform: translate(100%, 0)
</style>
