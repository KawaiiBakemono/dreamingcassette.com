---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import Section from "../components/Section.astro";
import Nav from "../components/Nav.astro";
import ImageShadow from "../components/ImageShadow.astro";

import otherImage from "../assets/Placeholder.png";
import profileImage from "../assets/AstraGuitar.webp";
import profileImageShadow from "../assets/AstraGuitar_Shadow.webp";
import psychoEngineLogo from "../assets/PsychoEngine-logo.png";
import siteLogo from "../assets/DreamingCassete_logo.png";
---

<DefaultLayout>
	<main>
		<img id="site-logo" src={siteLogo.src} alt="Site Logo" fetchpriority="high">

		<Section uid="about">
			<div>
				<Nav currentPage="home"/>
				<p>EMAIL: dreamingcassette@gmail.com</p>
				<div class="info-box">
					<h1 class="grid-span">About Dreamingcassette</h1>
					<ul class="grid-span">
						<li>i make things that are cool</li>
						<li>i can draw real good</li>
						<li>sometimes i write (dubiously well)</li>
						<li>i started PSYCHO ENGINE and we try to make stuff</li>
					</ul>
					<div class="align-row">
						<img src={psychoEngineLogo.src} alt="">
						<p >go checkout <a href="https://kawaiibakemono.art/home/" target="_blank">
							zephyrbytes</a> she's super cool (she made this website for me)</p>
					</div>

				</div>
			</div>
			<ImageShadow image={profileImage.src} shadow={profileImageShadow.src} alt="Astra Gutiar" />
		</Section>
		<Section uid="second-section"></Section>
		<footer>
			Made by ZephyrBytes
		</footer>
	</main>
</DefaultLayout>

<style lang="sass">
	@use "../styles/_variables" as *

	main
		display: flex
		flex-direction: column
		margin:
			left: 10vw
			right: 10vw
		z-index: 1
		background-image: url("../assets/background.jpg")
		background-size: 80vw
		background-origin: border-box
		background-repeat: no-repeat

	a
		color: $color-accent-default

	img
		display: flex

		&#site-logo
			margin:
				top: $gap-default
				right: $gap-default
			height: 7rem
			margin-left: auto

	.info-box
		display: flex
		flex-direction: column
		align-items: flex-start
		justify-content: space-between
		padding: $gap-default $gap-large
		background-color: $color-background-default
		margin:
			top: $gap-large
			bottom: $gap-huge
		border: 6px solid $color-background-dark
		width: 32vw

		img
			width: 10vw

	.align-row
		display: flex
		flex-direction: row
		gap: $gap-default

	h1
		font-size: $font-size-h1
		margin-block-start: $gap-tiny
		margin-block-end: $gap-tiny
		text-transform: uppercase
</style>
