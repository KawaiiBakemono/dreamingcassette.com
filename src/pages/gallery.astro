---
import DefaultLayout from '../layouts/DefaultLayout.astro';

import GalleryImage from "../components/GalleryImage.astro";
import Head from "../components/Head.astro";
import Nav from "../components/Nav.astro";

// Image imports
import astraPfp from "../assets/image/AstraPFP.png"
import zephyrPfp from "../assets/image/ZephyrPFP.png"
import junePfp from "../assets/image/JunePFP.png"
import sazabi from '../assets/image/SazabiComm.png';
import chloe from '../assets/image/Chloe.png';
import comicLucy from '../assets/image/HorrorComic_Lucy.png';
import comicTori from '../assets/image/HorrorComic_Tori.png';
import comicZephyr from '../assets/image/HorrorComic_Zephyr.png';
import noctMommy from '../assets/image/NoctMommy.png';
import willow from '../assets/image/WillowIsMelty.gif';
import aiCapsule from '../assets/image/AiCapsule.png';
import mirror from '../assets/image/ToTheMirror.gif';
import soLongStardust from '../assets/image/SoLongStardust.png';
import spookyPark from '../assets/image/SpookyPark.webp';
---

<script>
	import panzoom from "panzoom";

	var element: HTMLElement | SVGElement | null = document.getElementById("bulletin-board");
	if (element !== null) {
		panzoom(element, {
			bounds: true,
			boundsPadding: 0.1
		});
	}
</script>

<DefaultLayout>
	<Head slot="head" title="DreamingCassette - Home"
		description="My official portfolio site. Get in contact or browse my artwork"
		image={astraPfp.src} url="https://dreamingcassette.com/gallery" />

	<main slot="main">
		<Nav currentPage="gallery"></Nav>
		<div id="bulletin-board">
			<GalleryImage img={astraPfp.src} />
			<GalleryImage img={zephyrPfp.src} />
			<GalleryImage img={junePfp.src} />
			<div>
			</div>
			<div>
				<GalleryImage img={sazabi.src} />
				<GalleryImage img={chloe.src} />
			</div>
			<div>
				<GalleryImage img={comicLucy.src} />
				<GalleryImage img={comicTori.src} />
			</div>
			<div>
				<GalleryImage img={noctMommy.src} />
				<GalleryImage img={comicZephyr.src} />
			</div>
			<div>
				<GalleryImage img={willow.src} />
				<GalleryImage img={aiCapsule.src} />
				<GalleryImage img={mirror.src} />
			</div>
			<div>
				<GalleryImage img={soLongStardust.src} />
			</div>
			<GalleryImage img={spookyPark.src} />
		</div>
		<p id="help-text">Left Click to drag, Scroll to zoom</p>
	</main>
</DefaultLayout>

<style lang="sass">
	@use "../styles/_variables" as *

	main
		display: flex
		flex-direction: column
		justify-content: space-between
		height: 100vh

	#bulletin-board
		display: flex
		flex-direction: column
		flex-wrap: wrap
		// width: 500vw
		// height: 200vw
		padding: $gap-large
		background: $color-background-hover

	#help-text
		z-index: 99
		color: $color-background-default
		user-select: none
</style>