---
import DefaultLayout from "../layouts/DefaultLayout.astro";

import GalleryImage from "../components/GalleryImage.astro";
import Head from "../components/Head.astro";
import Nav from "../components/Nav.astro";
import Modal from "../components/Modal.astro";
import Footer from "../components/Footer.astro";

// Image imports
import astraPfp from "../assets/image/AstraPFP.png";
import zephyrPfp from "../assets/image/ZephyrPFP.png";
import junePfp from "../assets/image/JunePFP.png";
import sazabi from "../assets/image/SazabiComm.png";
import chloe from "../assets/image/Chloe.png";
import comicLucy from "../assets/image/HorrorComic_Lucy.png";
import comicTori from "../assets/image/HorrorComic_Tori.png";
import comicZephyr from "../assets/image/HorrorComic_Zephyr.png";
import noctMommy from "../assets/image/NoctMommy.png";
import willow from "../assets/image/WillowIsMelty.gif";
import aiCapsule from "../assets/image/AiCapsule.png";
import mirror from "../assets/image/ToTheMirror.gif";
import soLongStardust from "../assets/image/SoLongStardust.png";
import spookyPark from "../assets/image/SpookyPark.webp";
---

<script>
	import panzoom from "panzoom";
	import type { Transform } from "panzoom";

	var bulletinBoard: HTMLElement | null = document.getElementById("bulletin-board");

	if (bulletinBoard !== null) {
		const instance = panzoom(bulletinBoard, {
			bounds: true,
			boundsPadding: 0.1,
			minZoom: 0.25,
			maxZoom: 5,
			initialX: 0,
			initialY: 0,
			transformOrigin: { x: 0.5, y: 0.5 },
			zoomDoubleClickSpeed: 1,
		});

		// Reset position/zoom
		window.addEventListener("keydown", (event) => {
			const transform: Transform = instance.getTransform();
			var scale: number = 0.0;

			if (transform !== null) {
				scale = 1 / transform.scale;
			}
			console.log(transform)

			instance.smoothMoveTo
			if (event.key === "r") {
				instance.smoothMoveTo(0, 0);
				// instance.smoothZoom(0, 0, scale);
			}
		});
	}

</script>

<DefaultLayout>
	<Head
		slot="head"
		title="DreamingCassette - Gallery"
		description="My official portfolio site. Get in contact or browse my artwork"
		image={astraPfp.src}
		url="https://dreamingcassette.com/gallery"
	/>

	<main slot="main">
		<Modal />

		<div id="hud">
			<Nav currentPage="gallery" />
			<div id="help-text">
				<div>
					<p>Left Click to drag</p>
					<p>Scroll to zoom</p>
					<p>R to reset position</p>
				</div>
				<Footer />
			</div>
		</div>

		<div id="bulletin-board">
			<div>
				<GalleryImage class="art-small" img={astraPfp.src} />
				<GalleryImage class="art-small" img={zephyrPfp.src} />
				<GalleryImage class="art-small" img={junePfp.src} />
			</div>
			<div>
				<GalleryImage class="art-medium" img={sazabi.src} />
				<GalleryImage class="art-medium" img={chloe.src} />
			</div>
			<div>
				<GalleryImage class="art-medium" img={comicLucy.src} />
				<GalleryImage class="art-medium" img={comicTori.src} />
			</div>
			<div>
				<GalleryImage class="art-medium" img={noctMommy.src} />
				<GalleryImage class="art-medium" img={comicZephyr.src} />
			</div>
			<div>
				<GalleryImage class="art-medium" img={willow.src} />
				<GalleryImage class="art-medium" img={aiCapsule.src} />
			</div>
			<div>
				<GalleryImage class="art-large" img={soLongStardust.src} />
				<GalleryImage class="art-medium" img={mirror.src} />
			</div>
		</div>
	</main>
</DefaultLayout>

<style lang="sass">
	@use "../styles/_variables" as *

	main
		overflow: visible
		cursor: $cursor-grab

		&:active
			cursor: $cursor-grabbing

	#hud
		display: flex
		flex-direction: column
		position: absolute
		justify-content: space-between
		z-index: 2
		height: 100vh
		pointer-events: none

	#bulletin-board
		display: flex
		flex-direction: column
		align-items: center
		justify-content: center
		flex-wrap: wrap
		padding: $gap-large
		background-image: url("../assets/image/Bulletin.png")
		border-width: 50px
		border-style: solid
		border-image: url("../assets/image/BulletinBorder.png") 30%
		height: 115vh
		width: 160vw
		box-shadow: 10px 10px 10px $color-shadow-dark inset


	#help-text
		display: flex
		flex-direction: row
		align-items: flex-end
		justify-content: space-between
		color: $color-background-default
		user-select: none
		width: 100vw
		text-shadow: 2px 3px $color-foreground-default
		font-size: $font-size-small

		&:nth-child(2)
			align-self: end
</style>
