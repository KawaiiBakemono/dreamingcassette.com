---
import DefaultLayout from "../layouts/DefaultLayout.astro";

// COMPONENTS
import GalleryImage from "../components/GalleryImage.astro";
import Head from "../components/Head.astro";
import Nav from "../components/Nav.astro";
import Modal from "../components/Modal.astro";
import Footer from "../components/Footer.astro";
import ToggleButton from "../components/ToggleButton.astro";
import BulletinBoard from "../components/BulletinBoard.astro";

// IMAGES
import astraPfp from "../assets/image/AstraPfp.webp";
import zephyrPfp from "../assets/image/ZephyrPfp.webp";
import junePfp from "../assets/image/JunePfp.webp";
import sazabi from "../assets/image/SazabiComm.webp";
import chloe from "../assets/image/Chloe.webp";
import comicLucy from "../assets/image/HorrorComic_Lucy.webp";
import comicTori from "../assets/image/HorrorComic_Tori.webp";
import comicZephyr from "../assets/image/HorrorComic_Zephyr.webp";
import noctMommy from "../assets/image/NoctMommy.webp";
import willow from "../assets/image/WillowIsMelty.webp";
import aiCapsule from "../assets/image/AiCapsule.webp";
import mirror from "../assets/image/ToTheMirror.webp";
import soLongStardust from "../assets/image/SoLongStardust.webp";
import astraCommie from "../assets/image/AstraCommie.webp";
import spookyPark from "../assets/image/SpookyPark.webp";
import nobodyPfp from "../assets/image/NobodyPfp.webp";
import celestePfp from "../assets/image/CelestePfp.webp";
import ashAndBlood from "../assets/image/AshAndBlood.webp";
import artfightProfile from "../assets/image/ArtfightProfile.webp";
import hunterHunter from "../assets/image/HunterHunter.webp";
---

<DefaultLayout>
	<Head
		slot="head"
		title="DreamingCassette - Gallery"
		description="My official portfolio site. Get in contact or browse my artwork"
		image={astraPfp.src}
		url="https://dreamingcassette.com/gallery"
	/>
	<script is:inline src="../helper.ts"/>
	<main slot="main">
		<Modal />

		<div id="hud">
			<Nav currentPage="gallery" />
			<aside>
				<div>
					<p>Left Click to drag</p>
					<p>Scroll to zoom</p>
					<p>R to reset position</p>
				</div>
				<Footer />
			</aside>
		</div>

		<BulletinBoard>
			<div class="image-column">
				<GalleryImage class="art-medium" img={astraPfp.src} title="Astra Profile"
					desc="You look lonely... I can fix that."/>
				<GalleryImage class="art-medium" img={noctMommy.src} title="Space Mommy"
					desc='Noct, a character designed by <a href="https://kawaiibakemono.art/home/" target="_blank"> for one of my personal projects.'/>
				<GalleryImage class="art-medium" img={astraCommie.src} title="Astra Ushanka"
					desc="They're comfortable hats, I like them a lot."/>
			</div>
			<div class="image-column">
				<GalleryImage class="art-medium" img={sazabi.src} title="Sazabi (Commission)"
					desc="I've gotten pretty good at drawing mechanical things. Here's a huge robot to prove it"/>
				<GalleryImage class="art-medium" img={junePfp.src} title="June Profile"
					desc="I don't know how to describe this one I'll think of something later"/>
				<GalleryImage class="art-medium" img={chloe.src} title="Chloe (Commission)"
					desc="Furries are where the commission money is at, you know?"/>
			</div>
			<div class="image-column">
			</div>
			<div class="image-column">
				<GalleryImage class="art-medium" img={comicLucy.src} title="Night of the Rocking Dead"
					desc="Killer karaoke party..."
					url="https://artfight.net/~Vapidslacker" urlText="Vapidslacker - Artfight"/>
					<GalleryImage class="art-medium" img={comicTori.src} title="What Lurks in the Shadows"
					desc="I don't think that gun is gonna cut it..."
					url="https://artfight.net/~Torisyll0" urlText="Torisyll0 - Artfight"/>
					<GalleryImage class="art-medium" img={zephyrPfp.src} title="Zephyr Profile"
					desc='What is wrong with you? Why are you <span style="color: turquoise;">blue<span/>?'/>
				</div>
				<div class="image-column">
					<GalleryImage class="art-medium" img={comicZephyr.src} title="Things that go THUNK in the Night"
					desc="She loves throwing acorns at people. Be warned."
					url="https://artfight.net/~ZephyrBytes" urlText="ZephyrBytes - Artfight"/>
				<GalleryImage class="art-medium" img={willow.src} title="Willow is Melty"
					desc="An ArtFight piece; the fire is so cozy... Too bad she's a candle"
					url="https://artfight.net/~s_stompkinz" urlText="s_stompkinz - Artfight"/>
				<GalleryImage class="art-medium" img={aiCapsule.src} title="Ai Capsule"
					desc="Features the protagonist, Ai, from Waking Dreams, a WIP game."/>
			</div>
			<div class="image-column">
				<GalleryImage class="art-large" img={soLongStardust.src} title="So Long, Stardust"
					desc="[MISSING DESCRIPTION]"/>
				<GalleryImage class="art-medium" img={mirror.src} title="RANBL to the Mirror"
					desc="I made this animation for ArtFight and I am still so so proud of this"
					url="https://artfight.net/~frecoin" urlText="frecoin - Artfight"/>
				<GalleryImage class="art-wide" img={spookyPark.src} title="Spooky Park"
					desc="So many paranormal things all in one place ... how weird can it get?"/>
			</div>
			<div class="image-column">
				<GalleryImage class="art-large" img={nobodyPfp.src} title="□□□□□□"
					desc="□□□□ □□□□ □□□ □□□□□□ □□□□ □□□□□□□□"/>
				<GalleryImage class="art-medium" img={celestePfp.src} title="Celeste Profile"
					desc=`<img src="${hunterHunter.src}" alt="Hunter Hunter">`/>
				<GalleryImage class="art-medium" img={ashAndBlood.src} title="Ash & Blood"
					desc="Having a succubus dragon cat girlfriend thing has its perks"/>
			</div>
			<div class="image-column">
				<GalleryImage class="art-large" img={artfightProfile.src} title="Artfight Profile"
					desc="I made this for my profile page. It's still there, but I'll probably remake it for next year. Hopefully, better."/>
			</div>
		</BulletinBoard>
	</main>
</DefaultLayout>

<style lang="sass">
	@use "../styles/_variables" as *

	main
		overflow: visible

	#hud,
	aside
		display: flex
		justify-content: space-between

	#hud
		flex-direction: column
		position: absolute
		z-index: 2
		height: 100vh
		pointer-events: none

	aside
		align-items: flex-end
		color: $color-background-default
		user-select: none
		width: 100vw
		text-shadow: 2px 3px $color-foreground-default
		font-size: $font-size-small

		&:nth-child(2)
			align-self: end

	.image-column
		flex-direction: column
</style>
