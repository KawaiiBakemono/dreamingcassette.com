---
interface Props {
	overflow?: string;
}
const { overflow } = Astro.props;

import CRTFilter from "../components/CRTFilter.astro";
import HamburgerMenu from "../components/HamburgerMenu.astro";

import background from "../assets/image/BlackStars.webp";
import confirmSound from "../assets/sound/Confirm.ogg";

const bgHeight: string = background.height.toString() + "px";
---

<!doctype html>
<html lang="en">
	<slot name="head" />
	<body>
		<audio id="button-confirm">
			<source src={confirmSound} type="audio/ogg">
		</audio>
		<CRTFilter overflow={overflow}>
			<HamburgerMenu />
			<slot name="main" />
		</CRTFilter>
	</body>
</html>

<style is:global lang="sass" define:vars={{bgHeight}}>
	@use "../styles/_variables" as *

	html,
	body
		margin: 0
		width: 100%
		background-image: url("../assets/image/BlackStars.webp")
		animation: scroll 60s linear infinite
		scrollbar-color: $color-accent-default black
		font-family: $font-family
		font-size: $font-size
		outline: none
		cursor: $cursor-default

	main
		outline: none

	a,
	button,
	[role="button"]
		cursor: $cursor-default

	a.hover,
	button.hover,
	[role="button"].hover
		cursor: $cursor-pointer

	@keyframes scroll
		100%
			background-position: 0 var(--bgHeight)
</style>
