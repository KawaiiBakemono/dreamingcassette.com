---
import type { Target } from '../types';

interface Props {
	href: string;
	text: string;
	target?: Target;
}
const { href, text, target } = Astro.props;
---

<a href={href} target={target}>
	{text}
</a>

<style lang="sass">
	@use "../styles/_variables" as *

	a
		display: flex
		background-color: $color-background-default
		padding: $gap-default $gap-large
		text-align: center
		filter: drop-shadow($gap-default $gap-default $color-shadow)

		&:hover
			background-color: $color-background-hover

		&:active
			$offset: calc($gap-default - $gap-tiny)
			transform: translate($gap-tiny, $gap-tiny)
			filter: drop-shadow($offset $offset $color-shadow)
</style>