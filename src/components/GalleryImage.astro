---
interface Props {
	img: string;
	title: string;
	desc: string;
	url?: string;
	urlText?: string;
	class?: string;
}
const { img, title, desc, url, urlText, class: className, ...rest } = Astro.props;

import PushPin from '../assets/image/PushPin.webp';

// Set the alt text as the filename cuz man idgaf
const BASENAME_REGEX: RegExp = /([a-zA-Z0-9])+\.[a-z]+/;
let basename = img.split('/').reverse()[0].match(BASENAME_REGEX) as RegExpMatchArray;
let altText: string = "";

if (basename !== null) {
	altText = basename[0];
}
---

<script>
	const modal = document.getElementById("modal");
	const modalTitle = document.getElementById("modal-title");
	const modalBody = document.getElementById("modal-desc");
	const modalImage = document.getElementById("modal-image") as HTMLImageElement;
	const modalUrl = document.getElementById("modal-url") as HTMLAnchorElement;
	const externalLinkIcon = document.getElementById("modal-linkicon") as HTMLImageElement;

	const galleryImages = document.querySelectorAll(".art-wrapper") as NodeListOf<Element>;

	galleryImages.forEach((artwork: Element) => {
		artwork.addEventListener("click", (event) => appendToModal(event));
	});

	function appendToModal(event: Event): void {
		if (!modal || !modalTitle || !modalBody || !modalImage || !modalUrl) return;

		let target = event.currentTarget as HTMLElement;
		let targetImage = target.querySelector("#artwork") as HTMLImageElement;

		// Grab datasets from image
		const dataTitle: string = target.dataset.title ?? "N/A";
		const dataDescription: string = target.dataset.desc ?? "N/A";
		const dataUrl: string = target.dataset.url ?? "";
		const dataUrlText: string = target.dataset.urltext ?? "";

		modalTitle.textContent = dataTitle;
		modalBody.innerHTML = "";
		modalBody.insertAdjacentHTML("beforeend", dataDescription);

		modalUrl.innerHTML = "";
		if (dataUrl) {
			modalUrl.href = dataUrl;
			modalUrl.insertAdjacentHTML("beforeend", dataUrlText);
			externalLinkIcon.style.display = "flex";
		}
		else {
			externalLinkIcon.style.display = "none";
		}

		if (targetImage) {
			modalImage.src = targetImage.src;
			modalImage.alt = targetImage.alt;
		}

		modal.style.display = "flex";
	}
</script>

<button class:list={["art-wrapper", className]} data-title={title} data-desc={desc} data-url={url} data-urltext={urlText}>
	<img id="pushpin" src={PushPin.src} alt="Pushpin">
	<img id="artwork" src={img} alt={altText}>
</button>

<style lang="sass">
	@use "../styles/_variables" as *

	.art-wrapper
		display: grid
		appearance: none
		padding: $gap-small
		grid-template-columns: minmax(0, 1fr)
		grid-template-rows: minmax(0, 1fr)
		filter: drop-shadow(0.5rem 0.5rem $color-shadow-dark)
		cursor: $cursor-pointer
		transition: filter 250ms
		user-select: none

		&:hover
			filter: drop-shadow(0.5rem 1.8rem $color-shadow-dark)

			#artwork
				transform: rotate3d(1, 0, 0.1, 24deg)

	img
		grid-area: 1 / 1
		min-width: 0
		min-height: 0
		max-width: 100%
		max-height: 100%

	#artwork
		transform-origin: top center
		will-change: transform
		transition: transform 250ms

	.art-small
		width: 20vw

	.art-medium
		width: 25vw

	.art-large
		width: 30vw

	.art-wide
		width: 40vw

	#pushpin
		z-index: 1
		width: 2vw
		margin:
			left: auto
			right: auto
			top: -2vh

	@for $i from 1 through 3
		.art-wrapper:nth-child(#{$i})
			rotate: randomNum(-8, 8) + deg
</style>

<script>
	const modal = document.getElementById("modal");
	const artwork = document.getElementById("artwork");

	function openModal(): void {
		if (modal) {
			modal.style.display = "flex";
		}
	}

	if (artwork) {
		artwork.onclick = (event) => {
			openModal();
		}
	}
</script>