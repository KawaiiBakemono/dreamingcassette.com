---
interface Props {
	img: string;
	title: string;
	desc: string;
	class?: string;
}
const { img, title, desc, class: className, ...rest } = Astro.props;

import PushPin from '../assets/image/PushPin.png';

const BASENAME_REGEX: RegExp = /([a-zA-Z0-9])+\.[a-z]+/;
let basename = img.split('/').reverse()[0].match(BASENAME_REGEX) as RegExpMatchArray;
let altText: string = "";

if (basename !== null) {
	altText = basename[0];
}
---

<div class:list={["art-wrapper", className]} {...rest}>
	<img id="pushpin" src={PushPin.src} alt="Pushpin" oncontextmenu="return false">
	<img id="artwork" src={img} alt={altText} oncontextmenu="return false">
</div>

<style lang="sass">
	@use "../styles/_variables" as *

	.art-wrapper
		display: grid
		padding: $gap-small
		grid-template-columns: minmax(0, 1fr)
		grid-template-rows: minmax(0, 1fr)
		filter: drop-shadow(0.5rem 0.5rem $color-shadow-dark)
		cursor: pointer
		transition: filter 250ms

		&:hover
			filter: drop-shadow(0.5rem 1.8rem $color-shadow-dark)

			#artwork
				transform: rotate3d(1, 0, 0.1, 24deg)

	img
		grid-area: 1 / 1
		min-width: 0
		min-height: 0
		max-width: 100%
		max-height: 100%

	#artwork
		transform-origin: top center
		will-change: transform
		transition: transform 250ms

	.art-small
		width: 20vw

	.art-medium
		width: 25vw

	.art-large
		width: 30vw

	.art-wide
		width: 40vw

	#pushpin
		z-index: 1
		width: 2vw
		margin:
			left: auto
			right: auto
			top: -2vh

	@for $i from 1 through 3
		.art-wrapper:nth-child(#{$i})
			rotate: randomNum(-8, 8) + deg
</style>

<script>

</script>